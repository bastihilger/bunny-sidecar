{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bastihilger/bunny-sidecar",
    "description": "Share selected bunny.net DNS zones with people who should not see the rest of your bunny.net account, from a self-contained admin panel inside your Laravel app.",
    "keywords": [
        "laravel",
        "bunny",
        "bunny.net",
        "dns",
        "livewire",
        "bastihilger",
        "bunny-sidecar"
    ],
    "homepage": "https://github.com/bastihilger/bunny-sidecar",
    "license": "MIT",
    "authors": [
        {
            "name": "Sebastian Hilger",
            "email": "hilger@kraenk.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0||^13.0",
        "livewire/flux": "^2.13",
        "livewire/livewire": "^4.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^11.2",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "BunnySidecar\\BunnySidecar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BunnySidecar\\BunnySidecar\\Tests\\": "tests/",
            "BunnySidecar\\BunnySidecar\\Database\\Factories\\": "database/factories/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi"
    },
    "extra": {
        "laravel": {
            "providers": [
                "BunnySidecar\\BunnySidecar\\BunnySidecarServiceProvider"
            ],
            "aliases": {
                "BunnySidecar": "BunnySidecar\\BunnySidecar\\Facades\\BunnySidecar"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
